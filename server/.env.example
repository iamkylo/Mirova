# ── Mirova AI backend ────────────────────────────────────────────
# Copy this file to server/.env and fill in your key.
# server/.env is gitignored. It is read only by Node — Vite never sees it,
# so nothing here can end up in the browser bundle.

# Provider selector: openrouter | qwen | mock
# "mock" runs a canned diagram so you can test the pipeline with no key.
AI_PROVIDER=openrouter

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter vision model. Qwen-VL is the default.
#   qwen/qwen-2.5-vl-72b-instruct
#   qwen/qwen2.5-vl-7b-instruct
#   qwen/qwen-2-vl-7b-instruct
AI_MODEL=qwen/qwen-2.5-vl-72b-instruct

# Optional OpenRouter attribution headers
OPENROUTER_REFERER=
OPENROUTER_TITLE=Mirova Whiteboard

# ── Server ───────────────────────────────────────────────────────
PORT=8787

# Comma-separated allowlist. Use * only for local tinkering.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# ── Guardrails ───────────────────────────────────────────────────
AI_MAX_IMAGE_B64=6000000
AI_MAX_BODY=7mb
AI_MAX_HINT=500
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=60000
AI_RATE_WINDOW_MS=60000
AI_RATE_MAX=12
AI_MAX_CONCURRENT=3
